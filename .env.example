# Copy this file to .env and fill in the values. Never commit .env.
MONGO_URI=mongodb://localhost:27017/
DB_NAME=campusfix
SECRET_KEY=replace-with-a-long-random-string
FLASK_DEBUG=1
HOST=127.0.0.1
PORT=5000

# Google OAuth 2.0 (student login) — from Google Cloud Console > Credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://127.0.0.1:5000/auth/google/callback
# Official college email domain (no @, no http, NOT 127.0.0.1:5000). Used only on the server to accept student emails.
# It is not sent to Google, so Google's account chooser still shows every signed-in account.
GOOGLE_ALLOWED_DOMAIN=nec.edu.in

# Optional: base URL encoded in QR codes so phones can open it, e.g. http://192.168.1.20:5000 (use with HOST=0.0.0.0)
PUBLIC_BASE_URL=
